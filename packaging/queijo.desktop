[Desktop Entry]
Type=Application
Name=Queijo
Comment=Screenshots, screencasts and GIFs
Exec=queijo
Icon=queijo
Terminal=false
Categories=Utility;
Keywords=screenshot;screencast;gif;capture;
# KDE Plasma only lets programs listed here use its screenshot service.
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
Actions=settings;

[Desktop Action settings]
Name=Settings
Exec=queijo --settings
